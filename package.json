{
  "name": "scholar-meta-tags",
  "version": "0.1.0",
  "private": true,
  "description": "Public, auditable annotation platform for research papers: the GitHub repository is the database; rules and shapes come from the scholar-meta engine.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "intake": "tsx scripts/intake.ts",
    "export": "tsx scripts/export.ts",
    "sample": "tsx scripts/sample.ts",
    "replay": "tsx scripts/replay.ts",
    "check": "tsx scripts/check.ts",
    "redact": "tsx scripts/redact.ts",
    "bulk": "tsx scripts/import.ts",
    "tag": "tsx scripts/tag.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "test": "node --import tsx --test scripts/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "site:build": "tsx site/build.ts",
    "site:dev": "tsx site/build.ts --watch",
    "site:test": "pnpm -s export && pnpm -s site:build && node site/test/e2e.mjs",
    "site:live": "node site/test/live.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "scholar-meta": "https://github.com/sairaisaika/scholar-meta-visulization/releases/download/v0.6.3/scholar-meta-0.6.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^26",
    "esbuild": "^0.28.2",
    "playwright": "1.65.1",
    "tsx": "^4.19.0",
    "typescript": "^7"
  }
}
